# Copy to .env and fill in. Never commit the real .env file.

# Google AI Studio key (https://aistudio.google.com/apikey). Leave empty for offline mode.
GEMINI_API_KEY=
# Any Gemini model that supports function calling.
GEMINI_MODEL=gemini-3.5-flash
# auto = Gemini if a key is set, else the local endpoint if configured, else offline | gemini | local | offline
EMPORIO_LLM_MODE=auto
# Optional overrides. By default data/ is used when the original challenge files are
# there, otherwise the synthetic fixtures in data/sample/.
# EMPORIO_DATA_DIR=data
# EMPORIO_POLICY_PATH=data/políticas_da_loja.pdf

# --- Optional: local model (or any OpenAI-compatible endpoint) -------------------------------
# Used when GEMINI_API_KEY is empty (or EMPORIO_LLM_MODE=local). Examples:
#   Ollama:    LOCAL_LLM_BASE_URL=http://localhost:11434/v1   (ollama pull qwen2.5:7b-instruct)
#   LM Studio: LOCAL_LLM_BASE_URL=http://localhost:1234/v1    (load a GGUF model downloaded from Hugging Face)
# LOCAL_LLM_BASE_URL=
# LOCAL_LLM_MODEL=qwen2.5:7b-instruct
# LOCAL_LLM_API_KEY=
# LOCAL_LLM_TIMEOUT=120

# --- Optional: fallback and token budgets ------------------------------------------------------
# When Gemini fails (quota / HTTP 429 / RESOURCE_EXHAUSTED, network, ungrounded answer) use the local model
# configured above before falling back to the deterministic engine. true | false
# EMPORIO_LOCAL_FALLBACK=true
# Per-session token budgets (empty or 0 = unlimited). When reached, that provider is skipped.
# GEMINI_TOKEN_BUDGET=50000
# LOCAL_LLM_TOKEN_BUDGET=
# Name of the virtual assistant shown in the UI and used in the persona.
# EMPORIO_ASSISTANT_NAME=Vinicius
# Reply language: en = always English (the agent understands Portuguese) | auto = the customer's language.
# EMPORIO_REPLY_LANGUAGE=en
# All of the above can also be changed at runtime, per browser session, in the UI tab "Configurações".
